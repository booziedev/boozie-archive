{
  "name": "Boozie Archive",
  "short_name": "Archive",
  "description": "A personal, lossless-first music vault \u2014 browse, stream and download.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "any",
  "background_color": "#06060a",
  "theme_color": "#06060a",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "url": "/search"
    },
    {
      "name": "Artists",
      "url": "/artists"
    },
    {
      "name": "Favourites",
      "url": "/favourites"
    }
  ]
}
