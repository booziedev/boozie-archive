# ---------------------------------------------------------------------------
# boozie-archive frontend
# Copy to frontend/.env (local dev) or set these in your host's dashboard
# (Cloudflare Pages / Vercel / Netlify). Vite only exposes VITE_* variables.
# ---------------------------------------------------------------------------

# Base URL of the backend API.
#  - local development against the Pi on your LAN: http://raspberrypi.local:1981
#  - local development on the Pi itself:            http://localhost:1981
#  - production through Cloudflare Tunnel:          https://music-api.example.com
#  - production through Tailscale Funnel:           https://pi.tailXXXX.ts.net
VITE_API_BASE_URL=http://localhost:1981

# Title shown in the header, the browser tab and the iOS home-screen icon.
VITE_SITE_NAME=BOOZIE ARCHIVE

# Short tagline under the hero heading on the home page.
VITE_SITE_TAGLINE=A personal, lossless-first music vault.
