# ---------------------------------------------------------------------------
# boozie-archive frontend
# Copy to frontend/.env (local dev) or set these in your host's dashboard
# (Cloudflare Pages / Vercel / Netlify). Vite only exposes VITE_* variables.
# ---------------------------------------------------------------------------

# Base URL of the backend API.
#
# LEAVE THIS EMPTY when the Pi serves the web app itself (the default: the
# backend serves frontend/dist, so the app and the API share one origin and one
# tunnel). Empty means "same origin as this page", which is what you want for
# both `npm run dev` and a Pi-hosted build.
#
# Only set it when the frontend is hosted somewhere else (Cloudflare Pages,
# Vercel, Netlify) and has to reach the Pi across origins:
#   - through Cloudflare Tunnel:  https://music-api.example.com
#   - through Tailscale Funnel:   https://pi.tailXXXX.ts.net
#   - a LAN box during dev:       http://raspberrypi.local:1981
VITE_API_BASE_URL=

# Title shown in the header, the browser tab and the iOS home-screen icon.
VITE_SITE_NAME=BOOZIE ARCHIVE

# Short tagline under the hero heading on the home page.
VITE_SITE_TAGLINE=A personal, lossless-first music vault.
