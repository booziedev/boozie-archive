# ---------------------------------------------------------------------------
# boozie-archive backend
# Copy to backend/.env and adjust. Every value below is optional except
# MUSIC_ROOT, which must point at your collection.
# ---------------------------------------------------------------------------

# Absolute path to the music collection on the Pi.
MUSIC_ROOT=/home/admin/ssd/mediausb/music/

# HTTP listener. 1981 is the port used for local testing and by the
# cloudflared / Tailscale examples in the README.
HOST=0.0.0.0
PORT=1981

# Where the JSON index and the cover cache are written.
# Must be writable by the user running the service.
DATA_DIR=/home/admin/boozie-archive/backend/data

# Comma-separated list of allowed browser origins.
# "*" is fine for a public read-only archive; otherwise list your frontend URL:
#   CORS_ORIGINS=https://boozie-archive.pages.dev,http://localhost:5173
CORS_ORIGINS=*

# Scan the library when the process starts. With a large collection and a
# warm cache this only re-reads files whose size or mtime changed.
SCAN_ON_START=true

# Periodic background rescan, in minutes. 0 disables the timer.
SCAN_INTERVAL_MINUTES=360

# Files parsed in parallel. 4 is a good value for a Pi 5 with an SSD.
SCAN_CONCURRENCY=4

# Bearer token for POST /api/rescan. Leave empty to disable that route.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Cover thumbnail sizes generated on demand (requires the optional `sharp`).
COVER_SIZES=128,320,640

# Follow symlinks while scanning (off by default to avoid loops).
FOLLOW_SYMLINKS=false

# Serve the built web app (frontend/dist) from this same server, so the whole
# thing lives on one port behind one tunnel. Set to false if you host the
# frontend separately on Cloudflare Pages / Vercel / Netlify.
SERVE_FRONTEND=true

# Where the built frontend lives. The default resolves to ../frontend/dist
# relative to the backend working directory, which is what pm2 and the systemd
# unit both use — only set this if your layout differs.
# FRONTEND_DIST=/home/admin/boozie-archive/frontend/dist

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Accounts, invites and sessions  (see POSTGRES.md for the full setup)
# ---------------------------------------------------------------------------

# Require an account to browse, and an invite code to register.
# Set to false to run the archive wide open with no database at all.
AUTH_ENABLED=true

# PostgreSQL connection string. Percent-encode any @ / : # in the password.
DATABASE_URL=postgres://boozie:CHANGE_ME@127.0.0.1:5432/boozie_archive

# Set to true only for a managed Postgres that requires TLS.
DATABASE_SSL=false

# How long a signed-in browser stays signed in.
SESSION_TTL_DAYS=30

# Cookie settings. The defaults are right for a LAN / Tailscale setup over HTTP.
# If you host the frontend on Cloudflare Pages (a different origin) over HTTPS,
# set COOKIE_SAMESITE=none and COOKIE_SECURE=true, and list the exact frontend
# origin in CORS_ORIGINS above — "*" cannot be used with cookies.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Minimum password length accepted at registration.
MIN_PASSWORD_LENGTH=8

# Failed sign-ins allowed per username+IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Let signed-out visitors browse and play without an account.
# Registration still needs an invite; this only relaxes reading.
ALLOW_PUBLIC_BROWSE=false

# Which proxies may set X-Forwarded-For. "loopback" trusts only 127.0.0.1/::1,
# which is where cloudflared and Tailscale Funnel connect from. Trusting
# everything would let any client forge its IP past the login throttle.
#   loopback | false | a comma-separated list of CIDRs
TRUST_PROXY=loopback

# ---------------------------------------------------------------------------
# Friends, direct messages and profiles
# ---------------------------------------------------------------------------

# Abuse limits for messaging.
MESSAGE_RATE_PER_MINUTE=30
MESSAGE_MAX_LENGTH=2000
FRIEND_REQUESTS_PER_HOUR=30

# GIF search in direct messages and for animated profile pictures.
# Searches are proxied through this server, so these keys never reach the
# browser and the provider never sees your users' IP addresses.
#   Giphy: https://developers.giphy.com/dashboard/  (free)
#   Tenor: https://console.cloud.google.com/apis/library/tenor.googleapis.com
# Leave empty to hide that tab in the picker.
GIPHY_API_KEY=
TENOR_API_KEY=

# emoji.gg needs no key. Set to false to hide the emoji tab.
EMOJI_GG_ENABLED=true
